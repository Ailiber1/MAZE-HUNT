{
  "rules": {
    "users": {
      "$username": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['deviceId']) && newData.child('deviceId').isString()"
      }
    },
    "rooms": {
      "$roomId": {
        ".read": true,
        ".write": true,
        ".validate": "newData.val() != null"
      }
    },
    "rankings": {
      "scoreAttack": {
        ".read": true,
        "$deviceId": {
          ".write": true,
          ".validate": "newData.hasChildren(['username', 'score']) && newData.child('username').isString() && newData.child('username').val().length <= 16 && newData.child('score').isNumber()"
        }
      },
      "multi": {
        ".read": true,
        "$deviceId": {
          ".write": true,
          ".validate": "newData.hasChildren(['username', 'wins']) && newData.child('username').isString() && newData.child('username').val().length <= 16 && newData.child('wins').isNumber()"
        }
      }
    }
  }
}
